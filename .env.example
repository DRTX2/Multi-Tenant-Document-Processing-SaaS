# Configuración de Base de Datos PostgreSQL
# Copia este archivo a appsettings.Development.json y ajusta los valores

# Cadena de conexión de PostgreSQL
# Formato: Host=<servidor>;Database=<nombre_bd>;Username=<usuario>;Password=<contraseña>;Port=<puerto>

# Ejemplo para desarrollo local:
ConnectionStrings__DefaultConnection=Host=localhost;Database=aspnetproject;Username=postgres;Password=postgres;Port=5432

# Ejemplo para Docker:
# ConnectionStrings__DefaultConnection=Host=postgres;Database=aspnetproject;Username=postgres;Password=postgres;Port=5432

# Ejemplo para producción (usa variables de entorno):
# ConnectionStrings__DefaultConnection=${DATABASE_URL}

# Notas de seguridad:
# - NUNCA subas credenciales reales a Git
# - Usa variables de entorno en producción
# - Considera usar Azure Key Vault, AWS Secrets Manager, etc.
