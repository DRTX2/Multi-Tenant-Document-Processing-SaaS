<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
        <RootNamespace>AspNetProject.Api</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="Domain\**" />
        <Compile Remove="Application\**" />
        <Compile Remove="Infrastructure\**" />
        <Compile Remove="SchemaVerifier\**" />
        <EmbeddedResource Remove="Domain\**" />
        <EmbeddedResource Remove="Application\**" />
        <EmbeddedResource Remove="Infrastructure\**" />
        <None Remove="Domain\**" />
        <None Remove="Application\**" />
        <None Remove="Infrastructure\**" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="Domain\AspNetProject.Domain.csproj" />
        <ProjectReference Include="Application\AspNetProject.Application.csproj" />
        <ProjectReference Include="Infrastructure\AspNetProject.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.8.0" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.2" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <!-- Exclude the sub-project files from being picked up as unrelated items -->
    <ItemGroup>
        <None Include="Domain\AspNetProject.Domain.csproj" />
        <None Include="Application\AspNetProject.Application.csproj" />
        <None Include="Infrastructure\AspNetProject.Infrastructure.csproj" />
    </ItemGroup>

</Project>
